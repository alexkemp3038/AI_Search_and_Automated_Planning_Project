import tkinter as tk

# create main window
window = tk.Tk()
window.title("Sudoku Solver")
window.geometry("500x600")

#create grid framework
frame = tk.Frame(window)
frame.pack(pady=30)

#create dictionary for each cell
cells = {}

#create 9x9 grid
for i in range(9):
    for j in range(9):

        entry = tk.Entry(frame, width=3, font=("Arial", 18), jusitfy = "center")

        entry.grid(row= i, column= j, padx = 2, pady = 2)

        cells[(i,j)] = entry

# create button to press that will solve the sudoku puzzle
def click_solved():
    print ("Solve button clicked")

    button = tk.Button(window, text = "Solve Sudoku", font = ("Arial", 14), command =click_solved)

    button.pack(pady=20)

window.mainloop()
    
